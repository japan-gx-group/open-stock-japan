{
  "name": "open-stock-japan",
  "private": true,
  "version": "0.1.0",
  "description": "スタートアップの株主名簿・資本政策・ストックオプション・株主総会・取締役会・株主コミュニケーションを一元管理するオープンソースツール",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/japan-gx-group/open-stock-japan.git"
  },
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:migrations && npm run lint && npm run test && npm run build && npm run typecheck",
    "db:reset": "npx supabase db reset",
    "db:reset:demo": "npx supabase db reset --sql-paths \"./seeds/demo/*.sql\"",
    "db:seed:demo": "node scripts/db/seed.ts demo",
    "check:migrations": "node scripts/db/check-migrations.ts",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.9.2"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "brace-expansion@1": "^1.1.18",
    "brace-expansion@5": "^5.0.9",
    "js-yaml": "^5.2.3",
    "nanoid": "^3.3.18",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "lefthook": "^2.2.2",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.28",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
