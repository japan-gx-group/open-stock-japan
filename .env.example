# Supabase（https://supabase.com/dashboard → プロジェクト → Settings → API）
# このファイルをコピーして .env.local を作成し、実際の値を設定してください。
#   cp .env.example .env.local
# .env.local は絶対にコミットしないこと（.gitignore 済み）

# ブラウザに公開される値（NEXT_PUBLIC_ プレフィックス）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバ専用（管理者権限キー。クライアントコードで参照しないこと）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- 招待メールの送信（任意）---
# メンバー招待時に招待メールを送るための設定（Resend https://resend.com）。
# 未設定でも招待自体は使えます（招待リンクを手動で共有する運用になります）。
# どちらもサーバ専用の秘密情報。NEXT_PUBLIC_ を付けてブラウザへ公開しないこと。
# 詳細は docs/setup-guide.md の「招待メールの設定（任意）」を参照。
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# INVITE_EMAIL_FROM="OpenStock Japan <noreply@your-domain.example>"

# アプリの公開URL（任意）。招待メール内のリンクの origin と、CSP 違反レポートの
# 送信先（Reporting-Endpoints）に使われます。
# 未設定の場合はリクエストヘッダから導出しますが、リバースプロキシ配下では
# Host ヘッダ汚染を避けるため明示的な設定を推奨します。
# APP_URL=https://stock.example.com

# --- AI の設定（任意）---
# AI を使う機能（文書からの読取り・入力の補助・文章の下書き）で使う提供元と API キー。どちらもサーバ専用。NEXT_PUBLIC_ を付けてブラウザへ公開しないこと。
# 提供元は anthropic / google / openai のどれか。モデルは画面（組織・メンバー設定 > AI の設定）で管理者が選ぶ。
# 使ってよい API キーは、法人契約で、送った内容を学習に使わない設定のものだけ。Gemini は有料枠の鍵を使うこと。
# 詳細は docs/setup-guide.md の「2-I. AI の設定（任意）」を参照。
# AI_PROVIDER=anthropic
# AI_API_KEY=<提供元の API キー>
#
# 画面から API キーを登録する方式（方式B）。組織の情報管理の担当が「画面から登録してよい」と判断した場合だけ true にする。
# true にすると AI_PROVIDER / AI_API_KEY は読まず、管理者が「AI の設定」で本人確認（ログインパスワード）のうえ登録する。
# AI_ENCRYPTION_KEY は登録した鍵を暗号化する鍵（32 バイトの乱数を base64 にしたもの。openssl rand -base64 32 で作る）。
# SUPABASE_SERVICE_ROLE_KEY とは別の値にすること。替えると登録済みの鍵は読めなくなり、登録し直しになる。
# AI_ALLOWED_PROVIDERS は画面から登録してよい提供元（カンマ区切り。未設定なら 3 社すべて）。
# AI_ALLOW_KEY_REGISTRATION=true
# AI_ENCRYPTION_KEY=<openssl rand -base64 32 の出力>
# AI_ALLOWED_PROVIDERS=anthropic,openai

# --- 初回の登録の保護（本番では必須）---
# 初回の登録（/signup）は、組織がまだ 1 つも無いあいだ開けます。公開してから最初の登録までのあいだに
# 別の人が先に登録すると、その人が管理者になります。そのため、本番（NODE_ENV=production）では SETUP_TOKEN が必須で、
# 登録の画面でこの値を入力した人だけが登録できます（設定していないと、登録の画面は開けません）。
# 16 文字以上の乱数にしてください（openssl rand -base64 24 など）。最初の登録が済んだら消して構いません。
# 開発中（npm run dev）は、設定しなければ合言葉なしで登録できます。
# SETUP_TOKEN=<openssl rand -base64 24 の出力>

# --- 接続元の IP アドレスの決め方 ---
# アプリの前に置いている、信頼できるプロキシ（ロードバランサ・CDN・リバースプロキシ）の段数。既定は 1。
# 監査ログの「接続元」と、ログインの失敗の回数の制限は、X-Forwarded-For を右からこの段数だけ数えた位置の値を使います
# （左側の値は、利用者が自由に書けるため信じません）。
#   1 … プロキシが 1 段（Vercel、nginx 1 台など）
#   2 … CDN + ロードバランサなど 2 段
#   0 … プロキシを置かない（X-Forwarded-For を信じず、接続元を記録しない）
# アプリをプロキシなしで直接インターネットに公開すると、接続元は利用者の申告になります。プロキシの後ろに置いてください。
# TRUSTED_PROXY_HOPS=1

# --- セキュリティレスポンスヘッダ（任意）---
# HSTS は本番ビルドでのみ返します。詳細は docs/setup-guide.md「2-D. 本番運用時のセキュリティヘッダ」。
# includeSubDomains は兄弟サブドメインまで長期間 HTTPS 固定にし、ブラウザ側に残るため
# 既定では付けません。全サブドメインが HTTPS 化済みの場合のみ true にしてください。
# HSTS_MAX_AGE=63072000
# HSTS_INCLUDE_SUBDOMAINS=false

# --- ログ（任意）---
# サーバログ（pino）の出力レベル。未設定時は info。
# 指定できる値: fatal / error / warn / info / debug / trace / silent
# LOG_LEVEL=info

# --- 開発用（ローカル専用）---
# 初期セットアップ画面 /signup は「組織が1件も存在しないとき」だけ開ける仕様です。
# デモシード（npm run db:reset:demo / npm run db:seed:demo）を投入した場合はデモ組織が
# 存在するため、既定では開けません。
# true にすると、デモシードを消さずに /signup から新しい組織＋管理者アカウントを作れます。
# 本番ビルド（NODE_ENV=production）では、この値に関わらず必ず無効になります。
# 注: 既にログイン中だと /signup は /dashboard へ飛ばされるので、先にログアウトしてください。
# ALLOW_SETUP_WHEN_COMPLETED=true
